---
/*
 * Estado de las imágenes de los boletines en la portada de www.cali.gov.co.
 *
 * Página aparte del portafolio: NO usa Layout.astro ni global.css (ni
 * Tailwind ni los estilos del portafolio); trae su propio tema oscuro.
 *
 * - "Sin imagen ahora": lo revisa el navegador de quien abre la página,
 *   directo contra cali.gov.co (su portada y sus miniaturas permiten CORS).
 *   Una miniatura sin generar responde un 301 en vez de la imagen.
 * - Imágenes ya corregidas, historial y Excel: el vigía de autonex, que
 *   revisa la portada cada minuto en el servidor y publica sus datos (solo
 *   lectura) en autonex-publico.jodarini.dev. Si no responde, la página
 *   sigue mostrando lo que ve el navegador.
 */
const DATOS = 'https://autonex-publico.jodarini.dev/reporte-imagenes/datos';
const EXCEL = 'https://autonex-publico.jodarini.dev/reporte-imagenes/excel';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="Boletines de la portada de cali.gov.co que aparecen sin imagen y cuánto tardan en corregirse." />
    <link rel="icon" href="data:," />
    <title>Imágenes de boletines · cali.gov.co</title>
  </head>
  <body>
    <main id="reporte" data-datos={DATOS}>
      <header class="cabeza">
        <span id="chip" class="chip">Revisando…</span>
        <h1>Estado de las imágenes de los boletines en cali.gov.co</h1>
        <p id="resumen" class="resumen"></p>
        <p id="aviso" class="aviso" hidden></p>
      </header>

      <section class="tarjeta" aria-labelledby="t-rotas">
        <h2 id="t-rotas">Sin imagen ahora</h2>
        <p class="descripcion">Boletines que en este momento aparecen en la portada sin su imagen.</p>
        <ul id="rotas" class="filas"><li class="vacio">Revisando la portada…</li></ul>
      </section>

      <section class="tarjeta" aria-labelledby="t-lotes">
        <h2 id="t-lotes">Imágenes ya corregidas</h2>
        <p class="descripcion">
          Agrupadas por el minuto en que empezaron a mostrarse: las de un mismo grupo se corrigieron a la vez.
        </p>
        <div id="lotes"><p class="vacio">Cargando…</p></div>
      </section>

      <section class="tarjeta" aria-labelledby="t-historial">
        <h2 id="t-historial">Historial</h2>
        <p class="descripcion">Lo que detectó el monitoreo, del cambio más reciente al más antiguo.</p>
        <div id="eventos"><p class="vacio">Cargando…</p></div>
        <div id="eventos-mas"></div>
      </section>

      <footer class="barra">
        <div>
          <a id="excel" class="boton" href={EXCEL} hidden>Descargar Excel</a>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --fondo: #0f1115;
    --superficie: #171a21;
    --borde: #262a33;
    --texto: #e7e9ee;
    --suave: #9aa0ab;
    --rota: #f2767c;
    --ok: #5fd4a0;
    --enlace: #8ab4ff;
  }
  * { box-sizing: border-box; }
  html { background: var(--fondo); }
  body {
    margin: 0;
    background: var(--fondo);
    color: var(--texto);
    font: 15px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #reporte { max-width: 820px; margin: 0 auto; padding: 32px 16px 112px; }
  @media (min-width: 640px) { #reporte { padding: 56px 32px 112px; } }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--enlace); text-decoration: underline; }

  .cabeza { margin-bottom: 28px; }
  h1 { margin: 12px 0 6px; font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem); line-height: 1.2; font-weight: 650; letter-spacing: -0.01em; text-wrap: balance; }
  .resumen { margin: 0; font-size: 0.9rem; color: var(--suave); }
  .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
    font-size: 0.78rem; font-weight: 500; color: var(--suave); background: #20242c;
  }
  .chip::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .chip.rota { color: var(--rota); background: color-mix(in srgb, var(--rota) 14%, transparent); }
  .chip.ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); }
  .aviso {
    margin: 14px 0 0; padding: 10px 12px; border-radius: 8px; font-size: 0.85rem;
    color: #f5c46b; background: color-mix(in srgb, #f5c46b 10%, transparent);
    border: 1px solid color-mix(in srgb, #f5c46b 30%, transparent);
  }

  .tarjeta { background: var(--superficie); border: 1px solid var(--borde); border-radius: 12px; padding: 20px; margin-bottom: 16px; }
  h2 { margin: 0; font-size: 1rem; font-weight: 600; }
  .descripcion { margin: 2px 0 16px; font-size: 0.85rem; color: var(--suave); }
  ul { list-style: none; margin: 0; padding: 0; }
  .vacio { margin: 0; font-size: 0.875rem; color: var(--suave); }

  .filas > li { padding: 12px 0; border-top: 1px solid var(--borde); }
  .filas > li:first-child { border-top: 0; padding-top: 0; }
  .filas > li:last-child { padding-bottom: 0; }
  .titulo { font-weight: 600; }
  .datos { display: flex; flex-wrap: wrap; gap: 2px 16px; margin-top: 4px; font-size: 0.82rem; color: var(--suave); }
  .datos b { font-weight: 500; color: var(--texto); font-variant-numeric: tabular-nums; }
  .datos b.rota { color: var(--rota); }
  .datos b.ok { color: var(--ok); }

  .dia {
    margin: 24px 0 12px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--suave);
  }
  .dia:first-child { margin-top: 0; }
  .lote { margin-bottom: 20px; }
  .lote:last-child { margin-bottom: 0; }
  .lote h4 { margin: 0 0 8px; font-size: 0.875rem; font-weight: 600; }
  .lote ul { border-left: 2px solid color-mix(in srgb, var(--ok) 40%, transparent); padding-left: 12px; }
  .lote li { font-size: 0.9rem; margin-bottom: 10px; }
  .lote li:last-child { margin-bottom: 0; }

  .mas {
    display: block; width: 100%; margin-top: 16px; padding: 9px 12px; border-radius: 8px;
    border: 1px solid var(--borde); background: transparent; color: var(--texto);
    font: inherit; font-size: 0.875rem; font-weight: 500; cursor: pointer;
  }
  .mas:hover { background: #1e222a; }
  .mas span { color: var(--suave); font-weight: 400; }
  .nota { margin: 14px 0 0; font-size: 0.82rem; color: var(--suave); }
  .cabecera { display: none; }
  .cabecera + .dia { margin-top: 10px; }
  .historial li {
    display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; align-items: baseline;
    padding: 9px 0; border-top: 1px solid var(--borde); font-size: 0.86rem;
  }
  .historial li:first-child { border-top: 0; padding-top: 0; }
  .historial .boletin { grid-column: 1 / -1; min-width: 0; }
  @media (min-width: 640px) {
    .cabecera { display: grid; grid-template-columns: 5.5rem 11rem minmax(0, 1fr); gap: 0 16px; font-size: 0.75rem; color: var(--suave); }
    .historial li { grid-template-columns: 5.5rem 11rem minmax(0, 1fr); gap: 0 16px; }
    .historial .boletin { grid-column: auto; }
  }
  .historial .cuando { color: var(--suave); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .historial .rota { color: var(--rota); }
  .historial .ok { color: var(--ok); }
  .historial .que { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .historial .detalle { margin: 2px 0 0; font-size: 0.78rem; color: var(--suave); }

  .barra { position: fixed; left: 0; right: 0; bottom: 0; border-top: 1px solid var(--borde); background: color-mix(in srgb, var(--fondo) 90%, transparent); backdrop-filter: blur(8px); }
  .barra div { max-width: 820px; margin: 0 auto; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); display: flex; justify-content: flex-end; }
  @media (min-width: 640px) { .barra div { padding-inline: 32px; } }
  .barra:has(.boton[hidden]) { display: none; }
  .boton { border-radius: 8px; padding: 9px 16px; background: var(--texto); color: var(--fondo); font-weight: 600; font-size: 0.9rem; white-space: nowrap; }
  .boton:hover { color: var(--fondo); text-decoration: none; opacity: 0.9; }
  @media (max-width: 560px) { .boton { flex: 1; text-align: center; } }
</style>

<script>
  // Todo texto que viene de cali.gov.co o del vigía se pone con textContent
  // (nunca innerHTML) y los enlaces solo pueden ir a cali.gov.co.
  const PORTADA = 'https://www.cali.gov.co/';
  const ZONA = 'America/Bogota';
  const NOMBRES_BLOQUE: Record<string, string> = {
    '4328': 'Home 1 (Noticias destacadas)',
    '92627609': 'Home 2 (Noticia destacada)',
    '92627610': 'Slider de noticias',
  };
  // En pasado: cada evento es algo que ya ocurrió.
  const EVENTOS: Record<string, string> = {
    'aparece-rota': 'Apareció sin imagen',
    'aparece-con-imagen': 'Apareció con imagen',
    arreglada: 'Imagen corregida',
    'vuelve-a-fallar': 'Volvió a fallar',
    'sale-de-portada': 'Salió del home',
    'vuelve-a-portada': 'Volvió al home',
  };

  interface PubVigia {
    pubId: string;
    titulo: string;
    enlace: string | null;
    enPortada: boolean;
    /** La primera vez que el monitoreo lo vio en la portada. */
    primeraVez: string | null;
    estado: 'ok' | 'rota' | null;
    bloques: string[];
    /** La pone quien publica en el CMS (a veces solo el día): no mide nada. */
    publicada: string | null;
    /** Cuándo el monitoreo la vio sin imagen («Apareció sin imagen»): desde
     *  aquí se mide lo que tardó. */
    rotaDesde: string | null;
    /** Vista sin imagen al volver de una pausa (arranque, noche, caída): ya
     *  estaba así, lo que tardó es «al menos». */
    rotaTrasPausa?: boolean;
    ultimaRota: string | null;
    arreglada: string | null;
    /** Se arregló con el monitoreo en pausa: fue entre ultimaRota y arreglada. */
    arregloEnPausa?: boolean;
    minutosRota: number | null;
  }
  interface EventoVigia {
    at: string;
    pubId: string;
    titulo: string;
    tipo: string;
    /** Vista al volver de una pausa: «Ya estaba sin imagen». */
    trasPausa?: boolean;
    publicada: string | null;
  }
  interface DatosVigia {
    desde: string | null;
    /** El reporte empieza con los boletines publicados desde aquí (ISO). */
    reporteDesde?: string | null;
    /** De noche el monitoreo se detiene (horario en horas de Colombia). */
    enPausa?: boolean;
    horario?: { desde: number; hasta: number } | null;
    ultimaRevision: { at: string; ok: boolean; total: number | null } | null;
    publicaciones: PubVigia[];
    eventos: EventoVigia[];
  }
  interface Vista { pubId: string; titulo: string; enlace: string | null; bloques: string[]; rota: boolean }

  const raiz = document.getElementById('reporte')!;
  const URL_DATOS = raiz.dataset.datos!;
  const $ = (id: string) => document.getElementById(id)!;

  let vigia: DatosVigia | null = null;
  let enVivo: { at: string; vistas: Vista[] } | null = null;
  const publicadas = new Map<string, string>(); // pubId → ISO (las que el vigía no tiene)

  // «Ver más»: cuántos grupos de correcciones y cuántos cambios del historial
  // se muestran. Se conserva al refrescar cada minuto.
  const PASO_LOTES = 6;
  const PASO_EVENTOS = 25;
  // El servidor manda como mucho los últimos 300 cambios (publico.js); el
  // historial completo va en el Excel.
  const MAX_EVENTOS_PUBLICOS = 300;
  // Inicio del reporte (medianoche del 14 de octubre en Colombia) si el
  // vigía no responde; si responde, manda su `reporteDesde`.
  const REPORTE_DESDE = '2026-10-14T05:00:00.000Z';
  let limiteLotes = PASO_LOTES;
  let limiteEventos = PASO_EVENTOS;

  // ── Utilidades ──
  function el(tag: string, props?: Record<string, string> | null, ...hijos: (Node | string | null | false)[]) {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(props ?? {})) {
      if (k === 'text') n.textContent = v;
      else if (k === 'class') n.className = v;
      else n.setAttribute(k, v);
    }
    for (const h of hijos) if (h) n.append(h);
    return n;
  }
  const deCali = (url: string | null | undefined): string | null => {
    try {
      const u = new URL(url ?? '', PORTADA);
      return u.origin === 'https://www.cali.gov.co' ? u.href : null;
    } catch {
      return null;
    }
  };
  const hora = (iso: string | null) =>
    iso ? new Date(iso).toLocaleTimeString('es-CO', { timeZone: ZONA, hour: '2-digit', minute: '2-digit' }) : '—';
  const fechaHora = (iso: string | null) =>
    iso
      ? new Date(iso).toLocaleString('es-CO', { timeZone: ZONA, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
      : '—';
  /** Para frases: «las 3:28 p. m.» / «la 1:06 p. m.» (en español es «la una»).
   *  Sin el cero de adelante; la columna de hora sí lo lleva (alinea). */
  const aLas = (iso: string) => {
    const h = new Date(iso).toLocaleTimeString('es-CO', { timeZone: ZONA, hour: 'numeric', minute: '2-digit' });
    return `${/^1:/.test(h) ? 'la' : 'las'} ${h}`;
  };
  /** Día en Colombia como AAAA-MM-DD (para agrupar). */
  const claveDia = (iso: string | number) => new Date(iso).toLocaleDateString('en-CA', { timeZone: ZONA });
  /** «Hoy», «Ayer» o «Lunes 12 de octubre». */
  function etiquetaDia(iso: string) {
    const dia = claveDia(iso);
    if (dia === claveDia(Date.now())) return 'Hoy';
    if (dia === claveDia(Date.now() - 86_400_000)) return 'Ayer';
    const texto = new Date(iso).toLocaleDateString('es-CO', { timeZone: ZONA, weekday: 'long', day: 'numeric', month: 'long' });
    return texto.charAt(0).toUpperCase() + texto.slice(1).replace(',', '');
  }
  /** «13 de oct». */
  const diaMes = (iso: string) => new Date(iso).toLocaleDateString('es-CO', { timeZone: ZONA, day: 'numeric', month: 'short' });
  /** 7 → «las 7:00 a. m.» (1 → «la 1:00 p. m.»). */
  const aLaHora = (h: number) => `${h % 12 === 1 ? 'la' : 'las'} ${h % 12 || 12}:00 ${h < 12 ? 'a. m.' : 'p. m.'}`;
  const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

  /** La hora; con el día si no es el de `ref` (sin imagen desde ayer). */
  const horaJunto = (iso: string | null, ref: string | number) =>
    iso && claveDia(iso) !== claveDia(ref) ? fechaHora(iso) : hora(iso);

  /** Lo que tardó: desde «Apareció sin imagen» hasta «Imagen corregida», no
   *  desde la publicación del CMS (quien publica pone esa fecha, a veces
   *  solo el día, y las imágenes pueden subirse después). «12 min», «al
   *  menos 2 h» o, si se arregló con el monitoreo en pausa, «entre 29 min y
   *  9 h 30 min». */
  function textoTardanza(p: PubVigia) {
    const minutos = p.minutosRota ?? 0;
    if (p.arregloEnPausa && p.ultimaRota && p.rotaDesde) {
      const minimo = Math.max(0, Math.round((Date.parse(p.ultimaRota) - Date.parse(p.rotaDesde)) / 60000));
      return `entre ${duracion(minimo)} y ${duracion(minutos)}`;
    }
    return (p.rotaTrasPausa ? 'al menos ' : '') + duracion(minutos);
  }

  /** Una fila del historial: hora del cambio · qué pasó · boletín; debajo,
   *  su primer reporte y, en una corrección, cuánto tardó. */
  function filaEvento(e: EventoVigia, p: PubVigia | undefined) {
    const tono = e.tipo === 'arreglada' ? 'ok' : e.tipo === 'aparece-rota' || e.tipo === 'vuelve-a-fallar' ? 'rota' : '';
    // Visto al volver de una pausa (arranque, noche, caída): no «apareció» a
    // esa hora, ya estaba sin imagen.
    const yaEstaba = e.tipo === 'aparece-rota' && Boolean(e.trasPausa);
    // El enlace del boletín; si el vigía ya no lo tiene, el de su ID
    // (cali.gov.co lo redirige a la página del boletín).
    const url = p?.enlace ?? (/^\d+$/.test(e.pubId) ? `https://www.cali.gov.co/publicaciones/${e.pubId}/` : null);
    const titulo = enlace(e.titulo, url, 'que');
    titulo.setAttribute('title', e.titulo);
    const detalle: string[] = [];
    // El primer reporte del boletín (no su publicación en el CMS, que la pone
    // quien publica): en una corrección, cuándo se vio sin imagen; si no,
    // cuándo se vio por primera vez. La fila «Apareció…» ya es ese reporte.
    const primer = e.tipo === 'arreglada' && p?.arreglada === e.at ? p.rotaDesde : (p?.primeraVez ?? null);
    if (primer && primer !== e.at && !e.tipo.startsWith('aparece-')) {
      detalle.push(
        claveDia(primer) === claveDia(e.at)
          ? `primer reporte a ${aLas(primer)}`
          : `primer reporte el ${diaMes(primer)} a ${aLas(primer)}`,
      );
    }
    // Lo que tardó, en la corrección más reciente del boletín.
    if (e.tipo === 'arreglada' && p?.arreglada === e.at) {
      if (p.arregloEnPausa && p.ultimaRota) {
        detalle.push(`se corrigió entre ${aLas(p.ultimaRota)} y ${aLas(p.arreglada)}, con el monitoreo en pausa`);
      }
      detalle.push(`tardó ${textoTardanza(p)}`);
    }
    return el(
      'li',
      null,
      el('span', { class: 'cuando', text: hora(e.at) }),
      el('span', { class: tono, text: yaEstaba ? 'Ya estaba sin imagen' : (EVENTOS[e.tipo] ?? e.tipo) }),
      el('div', { class: 'boletin' }, titulo, detalle.length ? el('p', { class: 'detalle', text: mayuscula(detalle.join(' · ')) }) : null),
    );
  }

  function botonMas(texto: string, resto: string, alPulsar: () => void) {
    const b = el('button', { type: 'button', class: 'mas' }, `${texto} `, el('span', { text: resto }));
    b.addEventListener('click', alPulsar);
    return b;
  }
  function duracion(min: number) {
    if (min < 60) return `${min} min`;
    const h = Math.floor(min / 60);
    return min % 60 ? `${h} h ${min % 60} min` : `${h} h`;
  }
  const minutosDesde = (iso: string) => Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
  function enlace(titulo: string, url: string | null, clase = '') {
    const href = deCali(url);
    return href
      ? el('a', { class: clase, href, target: '_blank', rel: 'noopener noreferrer', text: titulo })
      : el('span', { class: clase, text: titulo });
  }
  const dato = (etiqueta: string, valor: string, clase = '') =>
    el('span', null, `${etiqueta}: `, el('b', { class: clase, text: valor }));

  // ── Revisión en vivo desde el navegador ──
  async function revisarEnVivo() {
    const r = await fetch(PORTADA, { cache: 'no-store' });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
    const porId = new Map<string, Vista & { miniatura: string }>();
    for (const img of doc.querySelectorAll<HTMLImageElement>('img[data-lazy*="thpub_"]')) {
      const lazy = img.getAttribute('data-lazy') ?? '';
      const id = /_(\d+)\.[a-z]+$/i.exec(lazy)?.[1];
      const miniatura = deCali(lazy);
      if (!id || !miniatura) continue;
      const bloque = /nxBlock(\d+)/.exec(img.closest('[class*="nxBlock"]')?.className ?? '')?.[1];
      const nombre = bloque ? (NOMBRES_BLOQUE[bloque] ?? `Bloque ${bloque}`) : null;
      const previa = porId.get(id);
      if (previa) {
        if (nombre && !previa.bloques.includes(nombre)) previa.bloques.push(nombre);
        continue;
      }
      porId.set(id, {
        pubId: id,
        titulo: (img.getAttribute('alt') ?? '').trim(),
        enlace: deCali(img.closest('a')?.getAttribute('href')),
        bloques: nombre ? [nombre] : [],
        miniatura,
        rota: false,
      });
    }
    const vistas = [...porId.values()];
    await Promise.all(
      vistas.map(async (v) => {
        try {
          const res = await fetch(v.miniatura, { method: 'HEAD', redirect: 'manual', cache: 'no-store' });
          v.rota = !(res.ok && (res.headers.get('content-type') ?? '').startsWith('image/'));
        } catch {
          v.rota = true;
        }
      }),
    );
    return { at: new Date().toISOString(), vistas };
  }

  /** Hora de publicación de las rotas que el vigía no conoce (meta de su página). */
  async function completarPublicadas(vistas: Vista[]) {
    const conocidas = new Set((vigia?.publicaciones ?? []).filter((p) => p.publicada).map((p) => p.pubId));
    const faltan = vistas.filter((v) => v.rota && v.enlace && !conocidas.has(v.pubId) && !publicadas.has(v.pubId));
    await Promise.all(
      faltan.map(async (v) => {
        try {
          const html = await (await fetch(v.enlace!)).text();
          const m = /<meta[^>]*property="article:published_time"[^>]*content="([^"]+)"/i.exec(html);
          if (m && !Number.isNaN(Date.parse(m[1]))) publicadas.set(v.pubId, new Date(m[1]).toISOString());
        } catch {
          /* sin hora de publicación */
        }
      }),
    );
  }

  // ── Pintar ──
  function pintar() {
    const delVigia = new Map((vigia?.publicaciones ?? []).map((p) => [p.pubId, p]));
    // Solo boletines publicados desde el inicio del reporte: los del vigía ya
    // vienen filtrados; los demás, por su fecha de publicación (sin ella aún,
    // no se muestran).
    const corte = Date.parse(vigia?.reporteDesde ?? REPORTE_DESDE);
    const enReporte = (v: Vista) => {
      if (delVigia.has(v.pubId)) return true;
      const publicada = publicadas.get(v.pubId);
      return publicada ? Date.parse(publicada) >= corte : false;
    };
    const rotas: Vista[] = enVivo
      ? enVivo.vistas.filter((v) => v.rota && enReporte(v))
      : (vigia?.publicaciones ?? [])
          .filter((p) => p.enPortada && p.estado === 'rota')
          .map((p) => ({ pubId: p.pubId, titulo: p.titulo, enlace: p.enlace, bloques: p.bloques, rota: true }));

    const chip = $('chip');
    if (!enVivo && !vigia) {
      chip.className = 'chip';
      chip.textContent = 'Sin datos';
    } else {
      chip.className = `chip ${rotas.length ? 'rota' : 'ok'}`;
      chip.textContent = rotas.length
        ? `${rotas.length} ${rotas.length === 1 ? 'boletín' : 'boletines'} sin imagen`
        : 'Todos con imagen';
    }

    const ultima = enVivo?.at ?? vigia?.ultimaRevision?.at ?? null;
    const resumen = ultima ? [`Actualizado a ${aLas(ultima)}`] : [];
    if (vigia?.enPausa && vigia.horario) resumen.push(`Monitoreo en pausa hasta ${aLaHora(vigia.horario.desde)}`);
    $('resumen').textContent = resumen.join(' · ');

    const avisos: string[] = [];
    if (!enVivo) avisos.push('No se pudo consultar cali.gov.co desde este navegador; se muestra la última revisión del servidor.');
    if (!vigia) avisos.push('El historial no está disponible en este momento; se muestra solo el estado actual.');
    const aviso = $('aviso');
    aviso.hidden = avisos.length === 0;
    aviso.textContent = avisos.join(' ');
    $('excel').hidden = !vigia;

    // Sin imagen ahora
    $('rotas').replaceChildren(
      ...(rotas.length
        ? rotas.map((v) => {
            const p = delVigia.get(v.pubId);
            // Desde que el vigía la vio sin imagen (primer reporte); sin él no
            // se afirma.
            const desde = p?.rotaDesde ?? null;
            const alMenos = p?.rotaTrasPausa ? 'al menos ' : '';
            return el(
              'li',
              null,
              enlace(v.titulo, v.enlace, 'titulo'),
              el(
                'div',
                { class: 'datos' },
                el('span', { text: [`#${v.pubId}`, ...v.bloques].join(' · ') }),
                dato('Primer reporte', horaJunto(desde, Date.now())),
                desde && dato('Sin imagen', alMenos + duracion(minutosDesde(desde)), 'rota'),
              ),
            );
          })
        : [el('li', { class: 'vacio', text: 'Todos los boletines de la portada tienen imagen.' })]),
    );

    // Imágenes ya corregidas (del vigía): por día, de la más reciente a la
    // más antigua; los grupos de a PASO_LOTES con «Ver más».
    if (!vigia) {
      $('lotes').replaceChildren(el('p', { class: 'vacio', text: 'No disponible en este momento.' }));
    } else {
      const lotes = new Map<string, { arreglada: string; items: PubVigia[] }>();
      for (const p of vigia.publicaciones) {
        if (p.estado !== 'ok' || !p.arreglada) continue;
        const lote = lotes.get(p.arreglada) ?? { arreglada: p.arreglada, items: [] };
        lote.items.push(p);
        lotes.set(p.arreglada, lote);
      }
      const ordenados = [...lotes.values()].sort((a, b) => b.arreglada.localeCompare(a.arreglada));
      const nodos: Node[] = [];
      let diaAnterior = '';
      for (const l of ordenados.slice(0, limiteLotes)) {
        const dia = claveDia(l.arreglada);
        if (dia !== diaAnterior) {
          nodos.push(el('h3', { class: 'dia', text: etiquetaDia(l.arreglada) }));
          diaAnterior = dia;
        }
        // Arregladas con el monitoreo en pausa: solo se sabe el intervalo.
        const enPausa = l.items.filter((p) => p.arregloEnPausa && p.ultimaRota);
        const desdePausa = enPausa.length ? enPausa.map((p) => p.ultimaRota!).sort()[0] : null;
        const plural = l.items.length === 1 ? 'Imagen arreglada' : 'Imágenes arregladas';
        nodos.push(
          el(
            'div',
            { class: 'lote' },
            el('h4', {
              text: desdePausa
                ? `${plural} entre ${aLas(desdePausa)} y ${aLas(l.arreglada)}`
                : `${plural} alrededor de ${aLas(l.arreglada)}`,
            }),
            el(
              'ul',
              null,
              ...l.items.map((p) =>
                el(
                  'li',
                  null,
                  enlace(p.titulo, p.enlace),
                  el(
                    'div',
                    { class: 'datos' },
                    dato('Primer reporte', horaJunto(p.rotaDesde, p.arreglada!)),
                    dato(
                      'Apareció la imagen',
                      p.arregloEnPausa && p.ultimaRota ? `entre ${hora(p.ultimaRota)} y ${hora(p.arreglada)}` : hora(p.arreglada),
                    ),
                    dato('Tardó', textoTardanza(p), 'ok'),
                  ),
                ),
              ),
            ),
          ),
        );
      }
      const ocultos = ordenados.slice(limiteLotes);
      if (ocultos.length) {
        const imagenes = ocultos.reduce((n, l) => n + l.items.length, 0);
        nodos.push(
          botonMas('Ver más', `(${imagenes} ${imagenes === 1 ? 'imagen' : 'imágenes'})`, () => {
            limiteLotes += PASO_LOTES;
            pintar();
          }),
        );
      }
      $('lotes').replaceChildren(
        ...(nodos.length ? nodos : [el('p', { class: 'vacio', text: 'Todavía no se ha corregido ninguna.' })]),
      );
    }

    // Historial: lo que detectó el monitoreo, por día y del más reciente al
    // más antiguo. La hora de cada fila es la del CAMBIO; la publicación del
    // boletín va debajo, con su etiqueta (si no, se confunden). De a
    // PASO_EVENTOS cambios con «Ver más».
    const mas = $('eventos-mas');
    if (!vigia) {
      $('eventos').replaceChildren(el('p', { class: 'vacio', text: 'No disponible en este momento.' }));
      mas.replaceChildren();
    } else if (!vigia.eventos.length) {
      $('eventos').replaceChildren(el('p', { class: 'vacio', text: 'Todavía no hay cambios.' }));
      mas.replaceChildren();
    } else {
      const nodos: Node[] = [
        el(
          'div',
          { class: 'cabecera', 'aria-hidden': 'true' },
          el('span', { text: 'Hora' }),
          el('span', { text: 'Qué pasó' }),
          el('span', { text: 'Boletín' }),
        ),
      ];
      let lista: HTMLElement | null = null;
      let diaAnterior = '';
      for (const e of vigia.eventos.slice(0, limiteEventos)) {
        const dia = claveDia(e.at);
        if (dia !== diaAnterior || !lista) {
          nodos.push(el('h3', { class: 'dia', text: etiquetaDia(e.at) }));
          lista = el('ul', { class: 'historial' });
          nodos.push(lista);
          diaAnterior = dia;
        }
        lista.append(filaEvento(e, delVigia.get(e.pubId)));
      }
      $('eventos').replaceChildren(...nodos);
      const restantes = vigia.eventos.length - limiteEventos;
      if (restantes > 0) {
        mas.replaceChildren(
          botonMas('Ver más', `(${restantes} ${restantes === 1 ? 'cambio' : 'cambios'})`, () => {
            limiteEventos += PASO_EVENTOS;
            pintar();
          }),
        );
      } else if (vigia.eventos.length >= MAX_EVENTOS_PUBLICOS) {
        mas.replaceChildren(el('p', { class: 'nota', text: 'Aquí se muestran los cambios más recientes; el historial completo está en el Excel.' }));
      } else {
        mas.replaceChildren();
      }
    }
  }

  // ── Ciclo ──
  async function cargarVigia() {
    try {
      const r = await fetch(URL_DATOS, { cache: 'no-store' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      vigia = (await r.json()) as DatosVigia;
    } catch {
      vigia = null;
    }
  }

  async function actualizar() {
    const [vivo] = await Promise.allSettled([revisarEnVivo(), cargarVigia()]);
    enVivo = vivo.status === 'fulfilled' ? vivo.value : null;
    pintar();
    if (enVivo) {
      await completarPublicadas(enVivo.vistas);
      pintar();
    }
  }

  let ocupado = false;
  async function ciclo() {
    if (ocupado || document.visibilityState !== 'visible') return;
    ocupado = true;
    try {
      await actualizar();
    } finally {
      ocupado = false;
    }
  }

  void ciclo();
  setInterval(ciclo, 60000);
  document.addEventListener('visibilitychange', ciclo);
</script>
