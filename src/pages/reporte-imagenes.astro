---
import Layout from '../layouts/Layout.astro';

/*
 * Reporte de las miniaturas de la portada de www.cali.gov.co.
 *
 * - "Sin imagen ahora": lo revisa el navegador de quien abre la página,
 *   directo contra cali.gov.co (su portada y sus miniaturas permiten CORS).
 *   Una miniatura sin generar responde un 301 en vez de la imagen.
 * - Arreglos, historial y Excel: el vigía de autonex, que revisa la portada
 *   cada minuto en el servidor y publica sus datos (solo lectura) en
 *   autonex-publico.jodarini.dev. Si no responde, la página sigue mostrando
 *   lo que ve el navegador.
 */
const DATOS = 'https://autonex-publico.jodarini.dev/reporte-imagenes/datos';
const EXCEL = 'https://autonex-publico.jodarini.dev/reporte-imagenes/excel';
---

<Layout
  title="Reporte de imágenes · cali.gov.co"
  lang="es"
  description="Miniaturas de la portada de cali.gov.co que salen sin imagen y cuándo se arreglan."
  robots="noindex, nofollow"
>
  <main id="reporte" data-datos={DATOS} data-excel={EXCEL}>
    <header class="mb-8">
      <span id="chip" class="chip">Revisando…</span>
      <h1 class="mt-3 mb-2 text-2xl sm:text-3xl font-bold text-[var(--accent)] leading-tight">
        Imágenes de la portada de cali.gov.co
      </h1>
      <p class="m-0 text-[0.95rem] text-neutral-400">
        Noticias de los sliders que salen con el recuadro gris en vez de su foto, y cuánto tardan en tenerla.
      </p>
      <p id="resumen" class="mt-3 mb-0 text-sm text-neutral-400"></p>
      <p id="aviso" class="aviso" hidden></p>
    </header>

    <section class="tarjeta">
      <h2>Sin imagen ahora</h2>
      <p class="descripcion">Lo que ve tu navegador en este momento.</p>
      <ul id="rotas" class="filas"><li class="vacio">Revisando la portada…</li></ul>
    </section>

    <section class="tarjeta">
      <h2>Arreglos</h2>
      <p class="descripcion">
        Las que se arreglaron en la misma revisión van juntas: cambiaron a la vez, dentro de ese minuto.
      </p>
      <div id="lotes"><p class="vacio">Cargando…</p></div>
    </section>

    <section class="tarjeta">
      <h2>Historial</h2>
      <p class="descripcion">Cada cambio que vio el vigía, con la fecha de publicación de la noticia.</p>
      <ul id="eventos" class="historial"><li class="vacio">Cargando…</li></ul>
    </section>

    <footer class="barra">
      <div>
        <p>Horas de Colombia. Una hoja por noticia y otra con cada cambio.</p>
        <a id="excel" class="boton" href={EXCEL} hidden>Descargar Excel</a>
      </div>
    </footer>
  </main>
</Layout>

<style is:global>
  #reporte {
    --rota: #eb6f92;
    --ok: #9ccfd8;
    --suave: #a3a3a3;
    --borde: rgba(255, 255, 255, 0.1);
    --tarjeta: #23262d;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem 7rem;
  }
  @media (min-width: 640px) {
    #reporte { padding: 3rem 2rem 7rem; }
  }
  #reporte a { color: inherit; text-decoration: none; }
  #reporte a:hover { text-decoration: underline; color: var(--accent); }
  #reporte .chip {
    display: inline-flex; align-items: center; gap: 0.4rem; border: 1px solid var(--borde);
    border-radius: 999px; padding: 0.15rem 0.7rem; font-size: 0.8rem; color: var(--suave);
  }
  #reporte .chip::before { content: ""; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: currentColor; }
  #reporte .chip.rota { color: var(--rota); border-color: color-mix(in srgb, var(--rota) 40%, transparent); }
  #reporte .chip.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
  #reporte .aviso {
    margin: 1rem 0 0; padding: 0.6rem 0.8rem; border-radius: 7px; font-size: 0.85rem;
    border: 1px solid color-mix(in srgb, #f6c177 45%, transparent); color: #f6c177;
  }
  #reporte .tarjeta {
    background: var(--tarjeta); border-radius: 7px; box-shadow: inset 0 0 0 1px var(--borde);
    padding: 1.25rem; margin-bottom: 1.25rem;
  }
  #reporte h2 { margin: 0; font-size: 1.1rem; color: var(--secondary); }
  #reporte .descripcion { margin: 0.25rem 0 1rem; font-size: 0.85rem; color: var(--suave); }
  #reporte ul { list-style: none; margin: 0; padding: 0; }
  #reporte .filas > li { padding: 0.75rem 0; border-top: 1px solid var(--borde); }
  #reporte .filas > li:first-child { border-top: 0; padding-top: 0; }
  #reporte .filas > li:last-child { padding-bottom: 0; }
  #reporte .titulo { font-weight: 600; color: #f5f5f5; }
  #reporte .datos { display: flex; flex-wrap: wrap; gap: 0.15rem 1rem; margin-top: 0.3rem; font-size: 0.82rem; color: var(--suave); }
  #reporte .datos b { font-weight: 500; color: var(--text); font-variant-numeric: tabular-nums; }
  #reporte .datos b.rota { color: var(--rota); }
  #reporte .datos b.ok { color: var(--ok); }
  #reporte .lote { margin-bottom: 1.25rem; }
  #reporte .lote:last-child { margin-bottom: 0; }
  #reporte .lote h3 { margin: 0 0 0.5rem; font-size: 0.9rem; color: #f5f5f5; }
  #reporte .lote h3 span { font-weight: 400; color: var(--suave); }
  #reporte .lote ul { border-left: 2px solid color-mix(in srgb, var(--ok) 45%, transparent); padding-left: 0.8rem; }
  #reporte .lote li { font-size: 0.88rem; margin-bottom: 0.6rem; }
  #reporte .lote li:last-child { margin-bottom: 0; }
  #reporte .historial li {
    display: grid; grid-template-columns: 1fr; gap: 0 1rem; padding: 0.4rem 0;
    border-top: 1px solid var(--borde); font-size: 0.82rem;
  }
  #reporte .historial li:first-child { border-top: 0; }
  @media (min-width: 640px) {
    #reporte .historial li { grid-template-columns: 10.5rem 10.5rem minmax(0, 1fr); }
  }
  #reporte .historial .cabecera { color: var(--suave); font-size: 0.75rem; padding-top: 0; }
  @media (max-width: 639px) { #reporte .historial .cabecera { display: none; } }
  #reporte .historial .cuando { color: var(--suave); font-variant-numeric: tabular-nums; white-space: nowrap; }
  #reporte .historial .rota { color: var(--rota); }
  #reporte .historial .ok { color: var(--ok); }
  #reporte .historial .que { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #reporte .vacio { margin: 0; font-size: 0.85rem; color: var(--suave); }
  #reporte .barra {
    position: fixed; left: 0; right: 0; bottom: 0; border-top: 1px solid var(--borde);
    background: color-mix(in srgb, #0e0e0e 92%, transparent); backdrop-filter: blur(6px);
  }
  #reporte .barra div {
    max-width: 800px; margin: 0 auto; padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    display: flex; align-items: center; gap: 1rem;
  }
  #reporte .barra p { flex: 1; margin: 0; font-size: 0.8rem; color: var(--suave); }
  #reporte .boton {
    border-radius: 7px; padding: 0.55rem 1rem; background: var(--accent); color: #0e0e0e !important;
    font-weight: 600; font-size: 0.9rem; white-space: nowrap;
  }
  #reporte .boton:hover { text-decoration: none; opacity: 0.9; }
  @media (max-width: 560px) {
    #reporte .barra p { display: none; }
    #reporte .boton { flex: 1; text-align: center; }
  }
</style>

<script>
  // Todo texto que viene de cali.gov.co o del vigía se pone con textContent
  // (nunca innerHTML) y los enlaces solo pueden ir a cali.gov.co.
  const PORTADA = 'https://www.cali.gov.co/';
  const ZONA = 'America/Bogota';
  const NOMBRES_BLOQUE: Record<string, string> = {
    '4328': 'Home 1 (Noticias destacadas)',
    '92627609': 'Home 2 (Noticia destacada)',
    '92627610': 'Slider de noticias',
  };
  const EVENTOS: Record<string, string> = {
    'aparece-rota': 'Aparece sin imagen',
    'aparece-con-imagen': 'Aparece con imagen',
    arreglada: 'Imagen arreglada',
    'vuelve-a-fallar': 'Vuelve a fallar',
    'sale-de-portada': 'Sale de la portada',
    'vuelve-a-portada': 'Vuelve a la portada',
  };

  interface PubVigia {
    pubId: string;
    titulo: string;
    enlace: string | null;
    enPortada: boolean;
    estado: 'ok' | 'rota' | null;
    bloques: string[];
    publicada: string | null;
    rotaDesde: string | null;
    rotaDesdePublicacion: boolean;
    ultimaRota: string | null;
    arreglada: string | null;
    minutosRota: number | null;
    minutosDesdePublicacion: number | null;
  }
  interface EventoVigia { at: string; pubId: string; titulo: string; tipo: string; publicada: string | null }
  interface DatosVigia {
    desde: string | null;
    ultimaRevision: { at: string; ok: boolean; total: number | null } | null;
    publicaciones: PubVigia[];
    eventos: EventoVigia[];
  }
  interface Vista { pubId: string; titulo: string; enlace: string | null; bloques: string[]; rota: boolean }

  const raiz = document.getElementById('reporte')!;
  const URL_DATOS = raiz.dataset.datos!;
  const $ = (id: string) => document.getElementById(id)!;

  let vigia: DatosVigia | null = null;
  let enVivo: { at: string; vistas: Vista[] } | null = null;
  const publicadas = new Map<string, string>(); // pubId → ISO (las que el vigía no tiene)

  // ── Utilidades ──
  function el(tag: string, props?: Record<string, string> | null, ...hijos: (Node | string | null | false)[]) {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(props ?? {})) {
      if (k === 'text') n.textContent = v;
      else if (k === 'class') n.className = v;
      else n.setAttribute(k, v);
    }
    for (const h of hijos) if (h) n.append(h);
    return n;
  }
  const deCali = (url: string | null | undefined): string | null => {
    try {
      const u = new URL(url ?? '', PORTADA);
      return u.origin === 'https://www.cali.gov.co' ? u.href : null;
    } catch {
      return null;
    }
  };
  const hora = (iso: string | null) =>
    iso ? new Date(iso).toLocaleTimeString('es-CO', { timeZone: ZONA, hour: '2-digit', minute: '2-digit' }) : '—';
  const fechaHora = (iso: string | null) =>
    iso
      ? new Date(iso).toLocaleString('es-CO', { timeZone: ZONA, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
      : '—';
  function duracion(min: number) {
    if (min < 60) return `${min} min`;
    const h = Math.floor(min / 60);
    return min % 60 ? `${h} h ${min % 60} min` : `${h} h`;
  }
  const minutosDesde = (iso: string) => Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
  const hace = (iso: string) => {
    const m = minutosDesde(iso);
    return m < 1 ? 'ahora' : `hace ${duracion(m)}`;
  };
  function enlace(titulo: string, url: string | null, clase = '') {
    const href = deCali(url);
    return href
      ? el('a', { class: clase, href, target: '_blank', rel: 'noopener noreferrer', text: titulo })
      : el('span', { class: clase, text: titulo });
  }
  const dato = (etiqueta: string, valor: string, clase = '') =>
    el('span', null, `${etiqueta}: `, el('b', { class: clase, text: valor }));

  // ── Revisión en vivo desde el navegador ──
  async function revisarEnVivo() {
    const r = await fetch(PORTADA, { cache: 'no-store' });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
    const porId = new Map<string, Vista & { miniatura: string }>();
    for (const img of doc.querySelectorAll<HTMLImageElement>('img[data-lazy*="thpub_"]')) {
      const lazy = img.getAttribute('data-lazy') ?? '';
      const id = /_(\d+)\.[a-z]+$/i.exec(lazy)?.[1];
      const miniatura = deCali(lazy);
      if (!id || !miniatura) continue;
      const bloque = /nxBlock(\d+)/.exec(img.closest('[class*="nxBlock"]')?.className ?? '')?.[1];
      const nombre = bloque ? (NOMBRES_BLOQUE[bloque] ?? `Bloque ${bloque}`) : null;
      const previa = porId.get(id);
      if (previa) {
        if (nombre && !previa.bloques.includes(nombre)) previa.bloques.push(nombre);
        continue;
      }
      porId.set(id, {
        pubId: id,
        titulo: (img.getAttribute('alt') ?? '').trim(),
        enlace: deCali(img.closest('a')?.getAttribute('href')),
        bloques: nombre ? [nombre] : [],
        miniatura,
        rota: false,
      });
    }
    const vistas = [...porId.values()];
    await Promise.all(
      vistas.map(async (v) => {
        try {
          const res = await fetch(v.miniatura, { method: 'HEAD', redirect: 'manual', cache: 'no-store' });
          v.rota = !(res.ok && (res.headers.get('content-type') ?? '').startsWith('image/'));
        } catch {
          v.rota = true;
        }
      }),
    );
    return { at: new Date().toISOString(), vistas };
  }

  /** Hora de publicación de las rotas que el vigía no conoce (meta de su página). */
  async function completarPublicadas(vistas: Vista[]) {
    const conocidas = new Set((vigia?.publicaciones ?? []).filter((p) => p.publicada).map((p) => p.pubId));
    const faltan = vistas.filter((v) => v.rota && v.enlace && !conocidas.has(v.pubId) && !publicadas.has(v.pubId));
    await Promise.all(
      faltan.map(async (v) => {
        try {
          const html = await (await fetch(v.enlace!)).text();
          const m = /<meta[^>]*property="article:published_time"[^>]*content="([^"]+)"/i.exec(html);
          if (m && !Number.isNaN(Date.parse(m[1]))) publicadas.set(v.pubId, new Date(m[1]).toISOString());
        } catch {
          /* sin hora de publicación */
        }
      }),
    );
  }

  // ── Pintar ──
  function pintar() {
    const delVigia = new Map((vigia?.publicaciones ?? []).map((p) => [p.pubId, p]));
    const rotas: Vista[] = enVivo
      ? enVivo.vistas.filter((v) => v.rota)
      : (vigia?.publicaciones ?? [])
          .filter((p) => p.enPortada && p.estado === 'rota')
          .map((p) => ({ pubId: p.pubId, titulo: p.titulo, enlace: p.enlace, bloques: p.bloques, rota: true }));

    const chip = $('chip');
    if (!enVivo && !vigia) {
      chip.className = 'chip';
      chip.textContent = 'Sin datos';
    } else {
      chip.className = `chip ${rotas.length ? 'rota' : 'ok'}`;
      chip.textContent = rotas.length ? `${rotas.length} sin imagen` : 'Todas con imagen';
    }

    const partes: string[] = [];
    if (enVivo) partes.push(`Revisado desde tu navegador ${hace(enVivo.at)}: ${enVivo.vistas.length} noticias en los sliders.`);
    if (vigia?.desde) partes.push(`El vigía revisa cada minuto (desde el ${fechaHora(vigia.desde)}).`);
    $('resumen').textContent = partes.join(' ');

    const avisos: string[] = [];
    if (!enVivo) avisos.push('Tu navegador no pudo revisar cali.gov.co; se muestra lo último que vio el vigía.');
    if (!vigia) avisos.push('El historial no está disponible en este momento; se muestra solo lo que ve tu navegador.');
    const aviso = $('aviso');
    aviso.hidden = avisos.length === 0;
    aviso.textContent = avisos.join(' ');
    $('excel').hidden = !vigia;

    // Sin imagen ahora
    $('rotas').replaceChildren(
      ...(rotas.length
        ? rotas.map((v) => {
            const p = delVigia.get(v.pubId);
            const publicada = p?.publicada ?? publicadas.get(v.pubId) ?? null;
            // Solo el vigía sabe si nunca tuvo imagen; sin él no se afirma.
            const desdePublicacion = Boolean(p?.rotaDesdePublicacion && publicada);
            const desde = desdePublicacion ? publicada : (p?.rotaDesde ?? null);
            const alMenos = !desdePublicacion && p?.rotaDesde && p.rotaDesde === vigia?.desde ? 'al menos ' : '';
            return el(
              'li',
              null,
              enlace(v.titulo, v.enlace, 'titulo'),
              el(
                'div',
                { class: 'datos' },
                el('span', { text: [`#${v.pubId}`, ...v.bloques].join(' · ') }),
                dato('Publicada', fechaHora(publicada)),
                desde && dato('Sin imagen', alMenos + duracion(minutosDesde(desde)), 'rota'),
              ),
            );
          })
        : [el('li', { class: 'vacio', text: 'Todas las noticias de la portada tienen imagen.' })]),
    );

    // Arreglos (del vigía)
    if (!vigia) {
      $('lotes').replaceChildren(el('p', { class: 'vacio', text: 'No disponible en este momento.' }));
    } else {
      const lotes = new Map<string, { arreglada: string; ultimaRota: string | null; items: PubVigia[] }>();
      for (const p of vigia.publicaciones) {
        if (p.estado !== 'ok' || !p.arreglada) continue;
        const lote = lotes.get(p.arreglada) ?? { arreglada: p.arreglada, ultimaRota: p.ultimaRota, items: [] };
        lote.items.push(p);
        lotes.set(p.arreglada, lote);
      }
      const ordenados = [...lotes.values()].sort((a, b) => b.arreglada.localeCompare(a.arreglada));
      $('lotes').replaceChildren(
        ...(ordenados.length
          ? ordenados.map((l) =>
              el(
                'div',
                { class: 'lote' },
                el(
                  'h3',
                  null,
                  fechaHora(l.arreglada),
                  el('span', {
                    text:
                      ` · ${l.items.length === 1 ? '1 miniatura' : `${l.items.length} miniaturas a la vez`}` +
                      (l.ultimaRota ? ` · cambió entre las ${hora(l.ultimaRota)} y las ${hora(l.arreglada)}` : ''),
                  }),
                ),
                el(
                  'ul',
                  null,
                  ...l.items.map((p) => {
                    const minimo = p.minutosDesdePublicacion == null && p.rotaDesde === vigia?.desde;
                    const tardo = p.minutosDesdePublicacion ?? p.minutosRota ?? 0;
                    return el(
                      'li',
                      null,
                      enlace(p.titulo, p.enlace),
                      el(
                        'div',
                        { class: 'datos' },
                        el('span', { text: `#${p.pubId}` }),
                        dato('Publicada', hora(p.publicada)),
                        dato('Con imagen', hora(p.arreglada)),
                        dato('Tardó', (minimo ? 'al menos ' : '') + duracion(tardo), 'ok'),
                      ),
                    );
                  }),
                ),
              ),
            )
          : [el('p', { class: 'vacio', text: 'Ninguna se ha arreglado todavía.' })]),
      );
    }

    // Historial (del vigía), con la fecha de publicación de cada noticia
    if (!vigia) {
      $('eventos').replaceChildren(el('li', { class: 'vacio', text: 'No disponible en este momento.' }));
    } else if (!vigia.eventos.length) {
      $('eventos').replaceChildren(el('li', { class: 'vacio', text: 'Todavía no hay cambios.' }));
    } else {
      $('eventos').replaceChildren(
        el(
          'li',
          { class: 'cabecera', 'aria-hidden': 'true' },
          el('span', { text: 'Publicada' }),
          el('span', { text: 'Evento' }),
          el('span', { text: 'Noticia' }),
        ),
        ...vigia.eventos.slice(0, 150).map((e) => {
          const tono = e.tipo === 'arreglada' ? 'ok' : e.tipo === 'aparece-rota' || e.tipo === 'vuelve-a-fallar' ? 'rota' : '';
          return el(
            'li',
            null,
            el('span', { class: 'cuando', title: `Evento: ${fechaHora(e.at)}`, text: fechaHora(e.publicada) }),
            el('span', { class: tono, text: EVENTOS[e.tipo] ?? e.tipo }),
            el('span', { class: 'que', title: e.titulo, text: e.titulo }),
          );
        }),
      );
    }
  }

  // ── Ciclo ──
  async function cargarVigia() {
    try {
      const r = await fetch(URL_DATOS, { cache: 'no-store' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      vigia = (await r.json()) as DatosVigia;
    } catch {
      vigia = null;
    }
  }

  async function actualizar() {
    const [vivo] = await Promise.allSettled([revisarEnVivo(), cargarVigia()]);
    enVivo = vivo.status === 'fulfilled' ? vivo.value : null;
    pintar();
    if (enVivo) {
      await completarPublicadas(enVivo.vistas);
      pintar();
    }
  }

  let ocupado = false;
  async function ciclo() {
    if (ocupado || document.visibilityState !== 'visible') return;
    ocupado = true;
    try {
      await actualizar();
    } finally {
      ocupado = false;
    }
  }

  void ciclo();
  setInterval(ciclo, 60000);
  document.addEventListener('visibilitychange', ciclo);
</script>
