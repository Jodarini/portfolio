---
const autonex = {
  title: "Autonex",
  status: "In production",
  lead: "The internal tool behind the Alcaldía de Cali's press releases. Publishing one on cali.gov.co used to take 20–30 minutes of manual work in the CMS. With Autonex it takes 1–2 minutes of review.",
  stats: [
    { value: "10–20×", label: "less hands-on time per press release" },
    { value: "6.4 min", label: "median time from email to live" },
    { value: "303", label: "press releases published in 6 weeks" },
    { value: "25 s", label: "median time to build a full draft" }
  ],
  footnote: "Autonex times are measured from its logs. The manual time is an estimate.",
  highlights: [
    { title: "Does the busywork.", text: "Reads the Word doc, crops the cover, builds the photo gallery and fills in every field of the CMS." },
    { title: "Starts before anyone asks.", text: "Press releases that arrive by email are drafted automatically, and a push notification on desktop or phone says when they're ready." },
    { title: "No silent failures.", text: "Catches duplicates and anything the CMS would quietly break, and checks every step by reading the CMS back." },
    { title: "People stay in control.", text: "It can't publish on its own: a person always makes the final click." }
  ],
  builtWith: "Solo and end to end, from product design to the server it runs on: a Vue 3 + shadcn-vue interface, a Bun and Express API that drives the CMS over plain HTTP (with Playwright as a fallback), 930 automated tests, and a Cloudflare setup that keeps it private.",
  video: "/projects/autonex.mp4",
  poster: "/projects/autonex-poster.webp",
  techStack: ["Vue 3", "TypeScript", "shadcn-vue", "Tailwind CSS", "Bun", "Express", "Playwright", "Web Push", "Cloudflare Access", "Vitest"]
};

const projects = [
  {
    title: "Stock it",
    description: "Stock It (Yobanas Manager) is a mobile‑first SaaS for fashion retailers to manage inventory, product variants, and sales analytics in real time. ",
    link: "https://yobanas-manager.vercel.app/",
    github: "https://github.com/Jodarini/yobanas-manager",
    image: "/projects/yobanas.png",
    techStack: ["TypeScript", "Vue 3", "Nuxt.js", "Tailwind CSS", "Drizzle-orm", "Postgresql", "Shadcn-vue"]
  },
  {
    title: "Split it",
    description: "A simple and intuitive app designed to help you easily split bills and receipts among friends ",
    link: "https://splitit.jodarini.dev",
    github: "https://github.com/Jodarini/SplitIt",
    image: "/projects/splitit.png",
    techStack: ["Vue.js", "TypeScript", "Tailwind CSS"]
  },
  {
    title: "Sclonetify",
    description: "A functional Spotify Clone written in TypeScript using NEXT.JS.",
    link: "https://sclonetify.jodarini.dev/",
    github: "https://github.com/Jodarini/spotify-clone",
    image: "/projects/sclonetify.png",
    techStack: ["React", "Next.js", "App Router", "TypeScript", "Spotify Web API", "Context API", "Tailwind CSS"]
  },
  {
    title: "Tarkov App",
    description: "A Next.js app built with TypeScript that fetches data from the Tarkov.dev API to display a comprehensive list of in-game items, including their prices and detailed information",
    link: "https://tarkov.jodarini.dev",
    github: "https://github.com/Jodarini/tarkov",
    image: "/projects/tarkov.png",
    techStack: ["TypeScript", "React","Next.js", "Pages Router", "Tailwind CSS", "GraphQL"]
  }
];
---

<section class="projects mb-16">
  <h3 class="text-2xl text-[var(--secondary)] mb-4 font-bold">Projects</h3>
  <div class="flex flex-col gap-4">
    <article class="rounded-lg overflow-hidden border border-[#c4a7e7]/30 p-4 flex flex-col gap-4">
      <video
        class="project-video w-full aspect-[1278/798] object-cover rounded-lg"
        src={autonex.video}
        poster={autonex.poster}
        width="1278"
        height="798"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={`Demo of ${autonex.title}`}
      ></video>

      <div class="flex flex-col gap-4">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <h4 class="text-[1.2rem] text-[var(--accent)] m-0 font-bold">{autonex.title}</h4>
            <span class="border border-[#c4a7e7]/40 text-[var(--accent)] px-2 py-0.5 rounded-full text-[0.7rem] uppercase tracking-widest">
              {autonex.status}
            </span>
          </div>
          <p class="text-base leading-relaxed m-0">{autonex.lead}</p>
        </div>

        <div>
          <dl class="grid grid-cols-2 sm:grid-cols-4 gap-2 m-0">
            {autonex.stats.map(stat => (
              <div class="flex flex-col-reverse justify-end rounded-lg border border-gray-200/10 p-3">
                <dt class="text-xs text-gray-400 leading-snug mt-1">{stat.label}</dt>
                <dd class="m-0 text-xl font-semibold text-gray-100">{stat.value}</dd>
              </div>
            ))}
          </dl>
          <p class="text-xs text-gray-500 mt-2 mb-0">{autonex.footnote}</p>
        </div>

        <ul class="text-sm leading-relaxed list-none p-0 m-0 flex flex-col gap-2">
          {autonex.highlights.map(highlight => (
            <li>
              <span class="font-bold text-gray-100">{highlight.title}</span> {highlight.text}
            </li>
          ))}
        </ul>

        <div>
          <h5 class="text-xs uppercase tracking-widest text-gray-500 font-bold mt-0 mb-2">How I built it</h5>
          <p class="text-sm leading-relaxed m-0">{autonex.builtWith}</p>
        </div>

        <div class="flex flex-wrap gap-2">
          {autonex.techStack.map(tech => (
            <span class="border border-gray-200/10 px-2 py-1 rounded-full text-[0.8rem]">
              {tech}
            </span>
          ))}
        </div>

        <div class="project-links flex flex-wrap gap-x-4 gap-y-2 justify-between items-baseline">
          <a href="#contact" class="project-link inline-block text-[var(--accent)] no-underline border-b border-[var(--accent)] transition-opacity duration-300 hover:opacity-80 text-sm">
            Have a process that eats hours every week? Let's automate it
          </a>
          <span class="flex gap-4 items-baseline">
            <a href={autonex.video} class="project-link inline-block text-[var(--secondary)] no-underline border-b border-[var(--secondary)] transition-opacity duration-300 hover:opacity-80 text-sm" target="_blank">
              Watch full size
            </a>
            <span class="text-sm text-gray-500">Private repo</span>
          </span>
        </div>
      </div>
    </article>

    {projects.map(project => (
    <div class="rounded-lg overflow-hidden border border-gray-200/10 p-4 flex flex-col gap-4">
        <img src={project.image} alt={`Preview of ${project.title}`} class="w-full object-cover rounded-lg" />
        <div class="project-content flex flex-col justify-between w-full">
          <h4 class="text-[1.2rem] text-[var(--accent)] mb-2 mt-0 font-bold">{project.title}</h4>
          <p class="text-sm mb-4 leading-relaxed">{project.description}</p>

          <div class="flex flex-wrap gap-2 mb-4">
            {project.techStack.map(tech => (
              <span class="border border-gray-200/10 px-2 py-1 rounded-full text-[0.8rem]">
                {tech}
              </span>
            ))}
          </div>

          <div class="project-links flex justify-between">
            {project.link &&
              <a href={project.link} class="project-link inline-block text-[var(--secondary)] no-underline border-b border-[var(--secondary)] transition-opacity duration-300 hover:opacity-80 text-sm" target="_blank">
                View Project
              </a>
            }
            <a href={project.github} class="project-link inline-block text-[var(--secondary)] no-underline border-b border-[var(--secondary)] transition-opacity duration-300 hover:opacity-80 text-sm" target="_blank">
              Github
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Sin animaciones para quien las pidió apagadas: el video queda en pausa
  // en su primer cuadro y con controles para reproducirlo a mano.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>(".project-video")) {
      video.pause();
      video.removeAttribute("autoplay");
      video.controls = true;
    }
  }
</script>
